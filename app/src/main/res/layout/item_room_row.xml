<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#14FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Información de la sala -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRoomName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/room_name_placeholder"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRoomCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/room_code_placeholder"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/txtPlayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/players_placeholder"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- Botón de unión -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJoinRoom"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:minWidth="80dp"
            android:layout_height="62dp"
            android:text="@string/join_room"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="15dp"
            app:strokeColor="@color/white" />

    </LinearLayout>

</androidx.cardview.widget.CardView>